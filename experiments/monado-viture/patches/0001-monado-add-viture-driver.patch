diff --git a/src/xrt/drivers/CMakeLists.txt b/src/xrt/drivers/CMakeLists.txt
index 5ec9910..682d15b 100644
--- a/src/xrt/drivers/CMakeLists.txt
+++ b/src/xrt/drivers/CMakeLists.txt
@@ -147,6 +147,41 @@ if(XRT_BUILD_DRIVER_XREAL_AIR)
 	list(APPEND ENABLED_HEADSET_DRIVERS xreal_air)
 endif()
 
+if(XRT_BUILD_DRIVER_VITURE)
+	# The VITURE SDK is proprietary and not redistributable, so it is not
+	# vendored: point VITURE_SDK_DIR at a directory containing
+	# include/viture_glasses_provider.h and x86_64/libglasses.so.
+	set(VITURE_SDK_DIR
+	    ""
+	    CACHE PATH "Directory of the VITURE XR Glasses SDK for Linux (contains include/ and x86_64/)"
+		)
+	find_path(VITURE_SDK_INCLUDE_DIR viture_glasses_provider.h PATHS "${VITURE_SDK_DIR}/include" NO_DEFAULT_PATH)
+	find_library(VITURE_SDK_LIBRARY NAMES glasses PATHS "${VITURE_SDK_DIR}/x86_64" NO_DEFAULT_PATH)
+	if(NOT VITURE_SDK_INCLUDE_DIR OR NOT VITURE_SDK_LIBRARY)
+		message(
+			FATAL_ERROR
+				"XRT_BUILD_DRIVER_VITURE=ON but the VITURE SDK was not found.\n"
+				"Pass -DVITURE_SDK_DIR=<dir>, where <dir> contains include/viture_glasses_provider.h "
+				"and x86_64/libglasses.so."
+			)
+	endif()
+
+	add_library(
+		drv_viture STATIC
+		viture/viture_hmd.h
+		viture/viture_hmd.c
+		viture/viture_interface.h
+		viture/viture_modes.h
+		viture/viture_modes.c
+		viture/viture_pose.h
+		viture/viture_pose.c
+		viture/viture_probe.c
+		)
+	target_link_libraries(drv_viture PRIVATE xrt-interfaces aux_util ${VITURE_SDK_LIBRARY})
+	target_include_directories(drv_viture PRIVATE ${VITURE_SDK_INCLUDE_DIR})
+	list(APPEND ENABLED_HEADSET_DRIVERS viture)
+endif()
+
 if(XRT_BUILD_DRIVER_UVC)
 	add_library(drv_uvc STATIC uvc/uvc_interface.h uvc/uvc_driver.c uvc/uvc_internal.h)
 	target_link_libraries(drv_uvc PRIVATE xrt-interfaces aux_os aux_util ${LIBUSB1_LIBRARIES})
