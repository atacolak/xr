#!/usr/bin/env bash
# Launch an OpenXR application against the freshly built Monado runtime.
#
#   scripts/run-hello-xr [path-to-binary]
#
# Defaults to the OpenXR-SDK hello_xr if it has been built next to this tree.
#
# Composition on this host defaults to the *compute* compositor (Monado picks
# that for non-Android when no display target is requested), so this can run
# with no glasses attached and no display topology change.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MONADO="${MONADO_DIR:-$HOME/workspace/monado}"
SDK="${VITURE_SDK_DIR:-$HOME/workspace/uxspace/Android/SDK/linux-x86_64}"
BUILD="$MONADO/build"

BIN="${1:-${HELLO_XR:-$HOME/workspace/openxr-sdk/build/hello_xr/hello_xr}}"
[ -x "$BIN" ] || { echo "hello_xr not found at $BIN (set HELLO_XR or pass a path)"; exit 1; }

RUNTIME_JSON="$(find "$BUILD" -maxdepth 4 -name 'openxr_monado*.json' | head -1)"
[ -n "$RUNTIME_JSON" ] || { echo "no monado runtime json in $BUILD"; exit 1; }

# The vendor SDK loads libcarina_vio from its own directory and that library
# needs its sibling OpenCV/usb shared objects.
export LD_LIBRARY_PATH="$SDK/x86_64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XR_RUNTIME_JSON="$RUNTIME_JSON"
export VITURE_LOG="${VITURE_LOG:-info}"
export XRT_COMPOSITOR_LOG="${XRT_COMPOSITOR_LOG:-info}"

echo "XR_RUNTIME_JSON=$XR_RUNTIME_JSON"
echo "LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
if ! lsusb 2>/dev/null | grep -qi '35ca'; then
  echo "NOTE: no VITURE device on USB right now."
  echo "      Add VITURE_NO_SDK=1 to validate enumeration with a static HMD."
fi

exec "$BIN" "$@"
