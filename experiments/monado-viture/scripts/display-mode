#!/usr/bin/env bash
# Put the glasses and X into a *matched* pair of states.
#
# Why this exists: on this host a display-mode change on the glasses makes the sink
# re-present its EDID, and X only re-reads the sink on hotplug. Doing it in the
# wrong order leaves X driving a timing the sink no longer offers, after which every
# xrandr call fails with BadMatch. That is the state that wedged the GPU display
# engine on 2026-10-04 (see beads xr-bi6.8). This script is the order that works:
#
#   1. ask the vendor device for the mode (0x43 2d / 0x45 sbs)
#   2. wait for X to offer the matching timing (the sink re-presents it)
#   3. only then point the X output at it
#
# Usage:
#   scripts/display-mode 2d            # 1920x1200@90, one image, usable desktop
#   scripts/display-mode sbs           # 3840x1200@90 side-by-side, one half per eye
#   scripts/display-mode sbs --pattern # ... and throw the stereo test pattern up
#
# Requires the glasses attached and the vendor udev rule installed (access is
# verified up front). Nothing here needs root.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SDK="${VITURE_SDK_DIR:-$HOME/workspace/uxspace/Android/SDK/linux-x86_64}"
TOOL="$ROOT/tools/viture-pose-dump"
export DISPLAY="${DISPLAY:-:1}"

WANT="${1:-2d}"
PATTERN=0
for a in "$@"; do [ "$a" = "--pattern" ] && PATTERN=1; done

# X derives the *screen's* physical size from the physical sizes of every attached output, and
# every toolkit asks it for the DPI. The glasses declare 3840x1200 millimetres for a 3840x1200
# pixel panel -- 25 dpi -- so merely attaching them rescales the whole desktop. Measured
# 2026-10-15: with the desktop monitor alone, the screen read back as 277 dpi against its true
# 110, rendering text 2.5x too large in every DPI-aware application. Pin the screen to the
# primary output's real geometry after every layout change; cheap and idempotent.
pin_dpi() {
	local line px mmwid dpi
	line=$(timeout 8 xrandr --query 2>/dev/null | awk '/ connected/ && / primary/ { print; exit }')
	[ -n "$line" ] || return 0
	px=$(awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) { split($i, a, "x"); print a[1]; exit } }' <<<"$line")
	mmwid=$(awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+mm$/) { sub(/mm$/, "", $i); print $i; exit } }' <<<"$line")
	[ -n "$px" ] && [ -n "$mmwid" ] && [ "$mmwid" -gt 0 ] 2>/dev/null || return 0
	dpi=$(awk -v p="$px" -v m="$mmwid" 'BEGIN { printf "%d", p / (m / 25.4) + 0.5 }')
	[ "$dpi" -gt 0 ] 2>/dev/null || return 0
	timeout 8 xrandr --dpi "$dpi" 2>/dev/null || true
	echo "--- screen dpi pinned to $dpi (primary ${px}px across ${mmwid}mm)"
}

# `off` is the resting state, and it is the default idea: the glasses are a presentation
# surface, not a monitor. With the sink in SBS and no XR app presenting, the desktop is split
# across the two eyes (left half one eye, right half the other), which is disorienting; and an
# enabled second output drags the window manager into giving it workspaces, which the operator
# notices as "I cannot reach workspaces one and two any more". So: nothing presenting, no
# display.
if [ "$WANT" = "off" ]; then
	echo "--- turning the glasses off (desktop left as the only active output)"
	timeout 15 xrandr --output DP-2 --off 2>/dev/null || true
	PRIMARY=$(timeout 8 xrandr --query 2>/dev/null | awk '/ primary/{print $1; exit}')
	[ -n "$PRIMARY" ] && timeout 15 xrandr --output "$PRIMARY" --pos 0x0 2>/dev/null || true
	# Deliberately do NOT talk to the device here. Turning the CRTC off already blanks the
	# glasses, and the sink's mode is irrelevant while it has no signal -- whereas issuing a
	# mode change and having its teardown cut short by the timeout left the device refusing
	# every subsequent mode command, which took a physical replug to clear.
	pin_dpi
	timeout 8 xrandr --query | grep -E "^Screen|^DP-0|^DP-2" | sed 's/^/    /'
	exit 0
fi

case "$WANT" in
	2d)
		MODE_NAME='1920x1200@90-2d'
		X_MODE='1920x1200'
		X_RATE='90'
		;;
	sbs)
		MODE_NAME='3840x1200@90-sbs'
		X_MODE='3840x1200'
		X_RATE='90'
		;;
	*)
		echo "usage: $0 off|2d|sbs [--pattern]" >&2
		exit 2
		;;
esac


[ -x "$TOOL" ] || { echo "no $TOOL (build it: tools/build-pose-dump.sh)" >&2; exit 1; }
command -v xrandr >/dev/null || { echo "no xrandr" >&2; exit 1; }
timeout 8 xrandr --query >/dev/null 2>&1 || { echo "X on $DISPLAY did not answer within 8 s (wedged?)" >&2; exit 1; }

# The output is chosen *after* the device mode is set, by whichever output offers the
# timing. Choosing before is what made this script point the glasses' timing at the desktop
# monitor: on a fresh connection the sink is in 2D, so nothing offers 3840x1200 yet.

if ! lsusb -d 35ca: >/dev/null 2>&1; then
	echo "glasses not on the USB bus; attach them first" >&2
	exit 1
fi

# 1. device side. The tool's SDK teardown can stall >15 s on an unhappy device, so
#    cap it and do not treat the timeout as a failure: the mode lands before that.
echo "--- setting device mode $MODE_NAME"
LD_LIBRARY_PATH="$SDK/x86_64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
	timeout 25 "$TOOL" --set-mode "$MODE_NAME" --seconds 2 2>&1 |
	grep -E "^display mode:|^set\(" || true

# 2. wait for X to be offered the timing (the sink re-presents its mode set)
echo "--- waiting for X to offer $X_MODE"
offered=""
for _ in $(seq 1 20); do
	offered=$(timeout 8 xrandr --query 2>/dev/null | awk -v m="$X_MODE" '
		/^[A-Za-z0-9_.-]+ connected/ { cur = $1 }
		cur != "" && $1 == m && $0 ~ /[0-9]+\.[0-9]+/ { print cur; exit }')
	[ -n "$offered" ] && break
	sleep 1
done
if [ -z "$offered" ]; then
	echo "    X never offered $X_MODE. Sink mode and X are out of step; a replug of the" >&2
	echo "    glasses makes X re-read the sink. Nothing changed." >&2
	exit 1
fi
OUT="${VITURE_OUTPUT:-$offered}"
echo "output=$OUT  target=$MODE_NAME  (X wants $X_MODE@$X_RATE)"

# 3. point X at it
echo "--- setting $OUT to $X_MODE@$X_RATE"
# Bounded on purpose: with the GPU display engine wedged the modeset ioctl *blocks*
# instead of failing, and an unbounded call hung an X server on 2026-10-04.
# Not --primary: the glasses are a presentation surface, not the desktop. Making them
# primary put them at the origin together with the monitor, so the two overlapped and the
# desktop showed a clipped mixture of both.
if ! timeout 20 xrandr --output "$OUT" --mode "$X_MODE" --rate "$X_RATE" --pos 0x0; then
	echo "    xrandr did not complete (hung or refused)." >&2
	echo "    Nothing in RandR will fix a wedged display engine: restart the display" >&2
	echo "    stack (systemctl restart gdm, or reboot) and run this again." >&2
	exit 1
fi
sleep 2
# The glasses hold the origin so an XR window placed at 0,0 lands on them alone; the desktop
# primary is pushed to their right. Non-overlapping is the whole point.
PRIMARY=$(timeout 8 xrandr --query | awk '/ primary/{print $1; exit}')
if [ -n "$PRIMARY" ] && [ "$PRIMARY" != "$OUT" ]; then
	GLW=$(timeout 8 xrandr --query | awk -v o="$OUT" '$1==o {split($3,a,"x"); print a[1]}')
	timeout 10 xrandr --output "$OUT" --pos 0x0 --output "$PRIMARY" --pos "${GLW:-3840}x0" && \
		echo "--- placed $OUT at 0x0, $PRIMARY to its right (no overlap)"
fi
pin_dpi
timeout 8 xrandr --query | sed -n "/^${OUT}/,/^[A-Z]/p" | head -4
timeout 8 xrandr --query --current | head -1
timeout 8 xrandr --listmonitors

if [ "$PATTERN" = 1 ]; then
	P="$ROOT/docs/stereo-test-pattern.png"
	if [ ! -f "$P" ]; then
		echo "no $P; skipping pattern" >&2
	else
		pkill -x feh 2>/dev/null || true
		setsid feh --fullscreen --no-menus --hide-pointer "$P" >/dev/null 2>&1 &
		echo "stereo test pattern up (left/right halves differ by disparity)"
	fi
fi
