#!/usr/bin/env bash
# Generic Fold-local Android device harness.
#
# Transport today:
#   this host -> SSH $XRCTL_SSH_HOST (default: fold)
#             -> Termux
#             -> Fold-local adb
#             -> 127.0.0.1:<current Wireless Debugging port>
#             -> Android
#
# The rotating ADB port is discovered beside the device. This script never
# scans for it over the network. Swap the transport later; keep the commands.
set -euo pipefail

XRCTL_SSH_HOST="${XRCTL_SSH_HOST:-fold}"
XRCTL_ADB_WIFI_TIMEOUT_S="${XRCTL_ADB_WIFI_TIMEOUT_S:-180}"
XRCTL_SETTLE_S="${XRCTL_SETTLE_S:-12}"
STATE_DIR="${XRCTL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/xrctl}"
RUNS="$STATE_DIR/runs"
KEEP_RUNS="${XRCTL_KEEP_RUNS:-15}"

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=10 -o ServerAliveCountMax=3)
REMOTE_ENV='export PREFIX=/data/data/com.termux/files/usr
export HOME=/data/data/com.termux/files/home
export PATH="$HOME/bin:$PREFIX/bin:/system/bin:/system/xbin:$PATH"
export ADB_MDNS_OPENSCREEN="${ADB_MDNS_OPENSCREEN:-1}"
mkdir -p "$HOME/tmp"
'

usage() {
  cat <<'EOFU'
Usage: xrctl <command> [args]

Device / ADB
  device status              SSH + adb state, displays, USB (no secrets)
  adb ensure                 make Fold-local wireless ADB `device`
  adb shell <args...>        adb shell on the live serial
  adb pair <code> <port>     one-time Wireless Debugging pair (local)

Packages
  deploy <apk> --package <pkg>   scp + adb install -r -d -t
  launch <pkg>                   start launcher activity
  stop <pkg>                     am force-stop
  smoke <pkg>                    stop, launch, wait, classify
  logs <pkg>                     recent logcat + crash excerpt

Sensors / display
  screenshot [path]            phone screencap PNG
  display                      dumpsys display summary (no ephemeral IDs as config)

Env: XRCTL_SSH_HOST XRCTL_STATE_DIR XRCTL_SETTLE_S XRCTL_ADB_WIFI_TIMEOUT_S
EOFU
}

die() { echo "xrctl: $*" >&2; exit 1; }
log() { printf '[xrctl] %s\n' "$*"; }

need_cmd() {
  local c="${1:-}"
  [ -n "$c" ] || { usage; die "missing command"; }
}

dev_ssh() {
  ssh "${SSH_OPTS[@]}" "$XRCTL_SSH_HOST" "$REMOTE_ENV$*"
}

# Pick the live `device` serial. Ignore offline/stale Wireless Debugging endpoints.
pick_serial() {
  local list
  list="$(dev_ssh 'adb devices')"
  local serial
  serial="$(printf '%s\n' "$list" | awk '/[[:space:]]device$/{print $1; exit}')"
  [ -n "$serial" ] || return 1
  printf '%s\n' "$serial"
}

dev_adb() {
  local serial
  serial="$(pick_serial)" || die "no adb device (run: xrctl adb ensure)"
  dev_ssh "adb -s $(printf '%q' "$serial") $*"
}

new_run() {
  mkdir -p "$RUNS"
  RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
  RUN="$RUNS/$RUN_ID"
  mkdir -p "$RUN"
  echo "$RUN" >"$STATE_DIR/last-run"
  local n
  n="$(find "$RUNS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
  if [ "$n" -gt "$KEEP_RUNS" ]; then
    find "$RUNS" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' \
      | sort -n | head -n "$((n - KEEP_RUNS))" | awk '{print $2}' \
      | while read -r d; do rm -rf "$d"; done
  fi
}

extract_crashes() {
  local logf="$1" out="$2"
  awk '
    BEGIN { grab=0; n=0 }
    /FATAL EXCEPTION/ { grab=1; n=0 }
    /FORTIFY:/ { grab=1; n=0 }
    grab { print; n++; if (n>120) { grab=0; n=0 } }
    grab && /^[-]+ beginning of/ { grab=0; n=0 }
    /Fatal signal/ { print; grab=1; n=1 }
    /DEBUG +: +signal / { print }
    /DEBUG +: +Abort message/ { print }
    /DEBUG +: +backtrace:/ { grab=1; n=1 }
  ' "$logf" >"$out" || true
}

cmd_adb_ensure() {
  log "ensuring Fold-local wireless ADB via $XRCTL_SSH_HOST"
  if pick_serial >/dev/null 2>&1; then
    log "adb already device"
    dev_ssh 'adb devices -l'
    return 0
  fi
  # Drop stale offline endpoints so the next connect is unambiguous.
  dev_ssh 'adb devices | awk "/offline$/{print \$1}" | while read -r s; do adb disconnect "$s" >/dev/null 2>&1 || true; done' || true
  set +e
  timeout "$XRCTL_ADB_WIFI_TIMEOUT_S" ssh "${SSH_OPTS[@]}" "$XRCTL_SSH_HOST" "$REMOTE_ENV"'adb-wifi'
  local rc=$?
  set -e
  if [ "$rc" -eq 124 ]; then
    die "adb-wifi timed out after ${XRCTL_ADB_WIFI_TIMEOUT_S}s"
  fi
  if ! pick_serial >/dev/null 2>&1; then
    cat >&2 <<'EOFE'
xrctl: Termux adb is not `device`.

This is the one-time OS pairing boundary (or Wireless Debugging is off).

On the Fold: Developer options -> Wireless debugging -> Pair device with pairing code.
Then, from this host while that dialog is up:

  xrctl adb pair <6-digit-code> <pairing-port>

After a successful pair, later cycles only need `xrctl adb ensure`.
Do not delete Termux ADB keys to "fix" this.
EOFE
    return 2
  fi
  log "adb device"
  dev_ssh 'adb devices -l'
}

cmd_adb_shell() {
  [ "$#" -ge 1 ] || die "usage: xrctl adb shell <args...>"
  local serial
  serial="$(pick_serial)" || { cmd_adb_ensure; serial="$(pick_serial)" || die "no adb device"; }
  # Pass through as a remote argv list. Caller is responsible for quoting.
  local q="" a
  for a in "$@"; do
    q+=" $(printf '%q' "$a")"
  done
  dev_ssh "adb -s $(printf '%q' "$serial") shell$q"
}

cmd_adb_pair() {
  local code="${1:-}" port="${2:-}"
  [ -n "$code" ] && [ -n "$port" ] || die "usage: xrctl adb pair <6-digit-code> <pairing-port>"
  log "adb pair 127.0.0.1:$port (on device)"
  dev_ssh "printf '%s\\n' $(printf '%q' "$code") | adb pair 127.0.0.1:$(printf '%q' "$port")"
  cmd_adb_ensure
}

cmd_device_status() {
  echo "=== transport ==="
  echo "ssh_host=$XRCTL_SSH_HOST"
  echo "=== ssh ==="
  dev_ssh 'whoami; hostname; echo sshd_ok'
  echo "=== adb ==="
  dev_ssh 'adb devices -l' || true
  if pick_serial >/dev/null 2>&1; then
    echo "=== get-state ==="
    dev_adb 'get-state' || true
    echo "=== model ==="
    dev_adb 'shell getprop ro.product.model'
    dev_adb 'shell getprop ro.build.version.release'
    echo "=== displays (names/modes; ids are ephemeral) ==="
    dev_adb 'shell dumpsys display' | awk '
      /Display Device:/ {p=1}
      p && /mDisplayId|DisplayDeviceInfo|uniqueId|width|height|fps|state=/ {print}
      p && /^$/ {if (++c>40) exit}
    ' | head -60
    echo "=== usb (vid/pid only) ==="
    dev_adb 'shell lsusb' 2>/dev/null | head -20 || true
  else
    echo "(adb not device — run xrctl adb ensure)"
  fi
}

parse_deploy_args() {
  APK=""
  PKG=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --package|-p)
        PKG="${2:-}"; shift 2 || die "missing --package value" ;;
      --package=*)
        PKG="${1#--package=}"; shift ;;
      --)
        shift; break ;;
      -*)
        die "unknown deploy option: $1" ;;
      *)
        if [ -z "$APK" ]; then APK="$1"; shift; else die "unexpected arg: $1"; fi ;;
    esac
  done
  [ -n "$APK" ] || die "usage: xrctl deploy <apk> --package <pkg>"
  [ -n "$PKG" ] || die "deploy requires --package <pkg>"
  [ -f "$APK" ] || die "apk not found: $APK"
}

cmd_deploy() {
  parse_deploy_args "$@"
  cmd_adb_ensure
  local remote="\$HOME/tmp/xrctl-deploy.apk"
  log "scp $APK -> $XRCTL_SSH_HOST:tmp/xrctl-deploy.apk"
  scp "${SSH_OPTS[@]}" "$APK" "$XRCTL_SSH_HOST:tmp/xrctl-deploy.apk"
  log "adb install -r -d -t ($PKG)"
  set +e
  dev_ssh 'adb install -r -d -t "$HOME/tmp/xrctl-deploy.apk"'
  local rc=$?
  set -e
  [ "$rc" -eq 0 ] || die "adb install failed (exit $rc)"
  dev_adb "shell pm path $PKG" || true
  dev_adb "shell dumpsys package $PKG" 2>/dev/null \
    | awk '/versionName=|versionCode=|lastUpdateTime=/{print}' | head -10 || true
}

resolve_activity() {
  local pkg="$1" act=""
  act="$(dev_adb "shell cmd package resolve-activity --brief $pkg" 2>/dev/null \
    | awk 'NF && $0 !~ /priority|No activity/{print; exit}')"
  if [ -z "$act" ] || [ "$act" = "No activity found" ]; then
    act="$(dev_adb "shell cmd package query-activities --brief -a android.intent.action.MAIN -c android.intent.category.LAUNCHER $pkg" 2>/dev/null \
      | awk 'NF && $0 ~ /\\//{print; exit}')"
  fi
  if [ -z "$act" ]; then
    act="$pkg/.MainActivity"
  fi
  printf '%s\n' "$act"
}

cmd_stop() {
  local pkg="${1:-}"
  [ -n "$pkg" ] || die "usage: xrctl stop <package>"
  cmd_adb_ensure
  dev_adb "shell am force-stop $pkg"
}

cmd_launch() {
  local pkg="${1:-}"
  [ -n "$pkg" ] || die "usage: xrctl launch <package>"
  cmd_adb_ensure
  local activity
  activity="$(resolve_activity "$pkg")"
  log "am start -W -n $activity"
  dev_adb "shell am start -W -n $activity"
}

cmd_screenshot() {
  local dest="${1:-}"
  cmd_adb_ensure
  if [ -z "$dest" ]; then
    mkdir -p "$STATE_DIR"
    dest="$STATE_DIR/screen.png"
  fi
  mkdir -p "$(dirname "$dest")"
  # screencap may warn about multiple displays; strip non-PNG prefix.
  local tmp
  tmp="$(mktemp)"
  dev_adb 'exec-out screencap -p' >"$tmp" || true
  python3 - "$tmp" "$dest" <<'PY'
import sys
src, dst = sys.argv[1], sys.argv[2]
data = open(src, "rb").read()
i = data.find(b"\x89PNG\r\n\x1a\n")
open(dst, "wb").write(data if i < 0 else data[i:])
PY
  rm -f "$tmp"
  if [ -s "$dest" ]; then
    log "screenshot $dest ($(stat -c%s "$dest") bytes)"
  else
    log "screenshot empty"
  fi
}

cmd_display() {
  cmd_adb_ensure
  echo "=== SurfaceFlinger display ids (ephemeral) ==="
  dev_adb 'shell dumpsys SurfaceFlinger --display-id' 2>/dev/null | head -40 || true
  echo "=== display devices ==="
  dev_adb 'shell dumpsys display' | awk '
    /Display Device:/ {p=1; print; next}
    p {print}
    p && /mCurrentLayerStack/ {p=0}
  ' | head -80
}

cmd_logs() {
  local pkg="${1:-}"
  [ -n "$pkg" ] || die "usage: xrctl logs <package>"
  cmd_adb_ensure
  local tmp
  tmp="$(mktemp)"
  dev_adb 'logcat -d -v threadtime' >"$tmp" || true
  echo "----- pid -----"
  dev_adb "shell pidof $pkg" || echo "(none)"
  echo "----- package lines (tail) -----"
  grep -E "$pkg|FATAL EXCEPTION|Fatal signal|FORTIFY:" "$tmp" | tail -80 || true
  echo "----- crash excerpt -----"
  extract_crashes "$tmp" /dev/stdout
  rm -f "$tmp"
}

cmd_smoke() {
  local pkg="${1:-}"
  [ -n "$pkg" ] || die "usage: xrctl smoke <package>"
  cmd_adb_ensure
  new_run
  local activity
  activity="$(resolve_activity "$pkg")"
  log "smoke $pkg activity=$activity settle=${XRCTL_SETTLE_S}s"
  printf '%s\n' "$activity" >"$RUN/activity.txt"

  log "clear logcat + force-stop"
  dev_adb "logcat -c" >/dev/null 2>&1 || true
  dev_adb "shell am force-stop $pkg" >/dev/null 2>&1 || true
  sleep 1

  log "am start -W"
  set +e
  dev_adb "shell am start -W -n $activity" | tee "$RUN/launch.txt"
  local start_rc=${PIPESTATUS[0]}
  set -e

  log "settling ${XRCTL_SETTLE_S}s"
  sleep "$XRCTL_SETTLE_S"

  dev_adb "shell pidof $pkg" >"$RUN/pid.txt" 2>&1 || true
  dev_adb "shell dumpsys activity activities" >"$RUN/dumpsys-activities.txt" 2>&1 || true
  dev_adb "logcat -d -v threadtime" >"$RUN/logcat.txt" 2>&1 || true
  cmd_screenshot "$RUN/screen.png" >/dev/null || true
  extract_crashes "$RUN/logcat.txt" "$RUN/crash-excerpt.txt"

  local pid=""
  pid="$(tr -d ' \n' <"$RUN/pid.txt" || true)"
  local resumed=0 fatal=0 native=0
  if grep -E "mResumedActivity.*$pkg|topResumedActivity.*$pkg|$pkg/" \
       "$RUN/dumpsys-activities.txt" >/dev/null 2>&1; then
    resumed=1
  fi
  if grep -E "FATAL EXCEPTION|Fatal signal|FORTIFY:" "$RUN/crash-excerpt.txt" >/dev/null 2>&1; then
    fatal=1
  fi
  if grep -E "Fatal signal|tombstone" "$RUN/crash-excerpt.txt" >/dev/null 2>&1; then
    native=1
  fi

  {
    echo "package=$pkg"
    echo "activity=$activity"
    echo "am_start_rc=$start_rc"
    echo "pid=${pid:-none}"
    echo "resumed=$resumed"
    echo "fatal=$fatal"
    echo "native=$native"
    echo "settle_s=$XRCTL_SETTLE_S"
    echo "run=$RUN"
  } | tee "$RUN/smoke.txt"

  local status detail
  if [ "$fatal" -eq 1 ] || [ "$native" -eq 1 ]; then
    status=FAIL_CRASH
    detail="process crashed; see $RUN/crash-excerpt.txt"
  elif [ -z "$pid" ]; then
    status=FAIL_DIED
    detail="no pid after ${XRCTL_SETTLE_S}s"
  elif [ "$start_rc" -ne 0 ]; then
    status=FAIL_LAUNCH
    detail="am start rc=$start_rc pid=$pid"
  elif [ "$resumed" -ne 1 ]; then
    status=FAIL_NOT_RESUMED
    detail="pid=$pid but activity not resumed"
  else
    status=PASS_STAGE_A
    detail="pid=$pid activity=$activity resumed"
  fi
  {
    echo "status=$status"
    echo "detail=$detail"
  } | tee "$RUN/classify.txt"
  [ "$status" = "PASS_STAGE_A" ]
}

main() {
  local cmd="${1:-}"
  shift || true
  need_cmd "$cmd"
  case "$cmd" in
    -h|--help|help) usage ;;
    device)
      case "${1:-}" in
        status|"") cmd_device_status ;;
        *) die "usage: xrctl device status" ;;
      esac
      ;;
    adb)
      case "${1:-}" in
        ensure) shift; cmd_adb_ensure "$@" ;;
        shell) shift; cmd_adb_shell "$@" ;;
        pair) shift; cmd_adb_pair "$@" ;;
        *) die "usage: xrctl adb ensure|shell|pair" ;;
      esac
      ;;
    deploy) cmd_deploy "$@" ;;
    launch) cmd_launch "$@" ;;
    stop) cmd_stop "$@" ;;
    smoke) cmd_smoke "$@" ;;
    logs) cmd_logs "$@" ;;
    screenshot) cmd_screenshot "${1:-}" ;;
    display) cmd_display ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
