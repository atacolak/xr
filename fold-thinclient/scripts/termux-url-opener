#!/data/data/com.termux/files/usr/bin/sh
# Play Store Termux FileReceiver execute path.
# ACTION_SEND of a Patterns.WEB_URL extra runs this file with the URL as $1.
# Only the HERDR sentinel starts Mosh/Herdr. Other URLs are not hijacked.
set -e
url="${1:-}"
case "$url" in
  https://herdr.colak.sh/launch|http://herdr.colak.sh/launch)
    exec mosh -p 60022 sfub -- herdr
    ;;
  *)
    printf 'termux-url-opener: %s\n' "$url"
    printf 'HERDR sentinel is https://herdr.colak.sh/launch\n'
    exec "${SHELL:-/data/data/com.termux/files/usr/bin/sh}" -i
    ;;
esac
